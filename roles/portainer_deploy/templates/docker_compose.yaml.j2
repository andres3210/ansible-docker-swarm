services:

  agent:
    image: portainer/agent:2.39.1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - agent_network
    deploy:
      mode: global
      placement:
        constraints: [node.platform.os == linux]

  portainer:
    image: portainer/portainer-ce:2.39.1
    command: -H tcp://tasks.agent:9001 --tlsskipverify
    # No published ports: Portainer is reached only through Traefik over HTTPS.
    # 9000 (HTTP UI) stays internal to the proxy network; 8000 (Edge agents) and 9443 are not used.
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /share/portainer:/data
    networks:
      - agent_network
      - proxy
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints: [node.role == manager]
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.portainer.rule=Host(`portainer.{{ traefik_domain }}`)"
        - "traefik.http.routers.portainer.entrypoints=websecure"
        - "traefik.http.routers.portainer.tls=true"
        - "traefik.http.routers.portainer.tls.certresolver=cloudflare"
        - "traefik.http.routers.portainer.service=portainer"
        - "traefik.http.services.portainer.loadbalancer.server.port=9000"

networks:
  agent_network:
    driver: overlay
    attachable: true
  # Created by the Traefik stack (stack "traefik", network "proxy"), so Traefik is deployed first.
  proxy:
    external: true
    name: traefik_proxy